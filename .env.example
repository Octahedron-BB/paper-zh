# 复制成 .env 并填入你自己的密钥。.env 已被 .gitignore 忽略，不要提交。
# ⚠️ 不要把密钥写进代码、笔记或聊天里。

# ---- LLM Provider（可切换）----
# deepseek | openai | gemini | mock | openai:<任意兼容端点>
LLM_PROVIDER=deepseek
# 留空则用 PRESETS 里的默认模型（见 src/providers.py）
LLM_MODEL=

DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- TTS 语音合成（可选切换）----
# edge-tts（默认，微软晓臻，免费且带逐句时间戳） | siliconflow（硅基流动 CosyVoice 2，超拟真音质）
TTS_PROVIDER=edge-tts
# 硅基流动 API Key（从 https://cloud.siliconflow.cn 获取）
SILICONFLOW_API_KEY=
# 硅基流动可选模型与音色（留空使用默认值）
SILICONFLOW_TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
SILICONFLOW_TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:alex

# ---- 可选：学术机构代理 / 网页版全文抓取 (Institutional Proxy) ----
# 支持通过高校校园网远程访问 (EZproxy / CARSI) 或机构镜像，直接拉取 Nature 等期刊网页版 HTML
# 留空则默认使用本地 papers/ 目录下的 PDF 或 HTML
ACADEMIC_PROXY_BASE_URL=
ACADEMIC_PROXY_COOKIE=
# 可选：第三方文献平台自动化登录换取（如有）
CHACHONG_USERNAME=
CHACHONG_PASSWORD=

# ---- 可选：文献速览的推送渠道（tools/push_digest.py）----
# 只配你实际要用的即可。查看配置状态：
#     python tools/push_digest.py --list-channels
# 发送（可多选、可单选）：
#     python tools/push_digest.py --channels telegram,discord
#     python tools/push_digest.py --channels all

# 微信（PushPlus / 推送加）：token 在 pushplus.plus 个人中心获取
PUSHPLUS_TOKEN=
# 可选：群组编码。不填只发给自己
PUSHPLUS_TOPIC=
# 可选：详情页的 content 格式，html（默认，排版最好）/ markdown / txt
# 注：对话列表里那张卡片是微信模板消息，字段经微信审核，官方明确说不可自定义；
#     能控制的只有"点进去之后"的详情页。
PUSHPLUS_TEMPLATE=

# Telegram Bot：chat_id 可先给 bot 发一条消息，
# 再访问 https://api.telegram.org/bot<你的token>/getUpdates 查看
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord：以下两种方式**二选一**即可
# ① Webhook（推荐，不需要常驻 bot 进程）
#    服务器设置 → 整合 → Webhook → 新建 → 复制 Webhook URL
DISCORD_WEBHOOK_URL=
# ② 或使用 Bot：Bot Token + 目标频道 ID
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
